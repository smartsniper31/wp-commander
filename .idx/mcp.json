{
    "mcpServers": {
        "firebase": {
            "command": "npx",
            "args": [
                "-y",
                "firebase-tools@latest",
                "experimental:mcp"
            ]
        },
        "wp-commander": {
            "command": "php",
            "args": [
                "-S",
                "localhost:8000",
                "-t",
                "wp_plugin/wp-commander"
            ]
        }
    }
}
